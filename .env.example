# ---------------------------------------------------------------------------
# portfolio-insight-mcp — environment variable template
#
# Copy this file to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# =============================================================================
# Wealthfolio API Configuration (Required)
# =============================================================================

# Base URL of the Wealthfolio instance (e.g., http://localhost:3000)
WEALTHFOLIO_BASE_URL=http://localhost:3000

# Password for Wealthfolio authentication (leave empty if auth is disabled)
WEALTHFOLIO_PASSWORD=

# =============================================================================
# MCP Server Configuration
# =============================================================================

# Transport mode: "stdio" or "http"
MCP_TRANSPORT=http

# HTTP server listen address (only used when MCP_TRANSPORT=http)
MCP_ADDR=:8080

# =============================================================================
# Authentication
# =============================================================================

# Fixed bearer token for MCP API access (recommended for HTTP mode in production)
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# =============================================================================
# Optional Settings
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info
